{
  "manifest_version": 3,
  "name": "Wish It",
  "version": "1.0.0",
  "description": "Add any product to your Wish It wishlist in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/16.png",
      "48":  "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://xkluvitzmftxhlmefckr.supabase.co/*"
  ],
  "icons": {
    "16":  "icons/16.png",
    "48":  "icons/48.png",
    "128": "icons/128.png"
  }
}
